[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .tox,
    .venv,
    venv,
    pretix-test,
    locale

# E203: whitespace before ':'  (conflicts with black)
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator
ignore = E203,E501,W503

per-file-ignores =
    __init__.py:F401
