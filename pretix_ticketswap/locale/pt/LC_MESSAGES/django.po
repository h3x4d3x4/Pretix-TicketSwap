# Plugin metadata
msgid "TicketSwap Integration"
msgstr "Integração TicketSwap"

msgid "Integrate your Pretix events with TicketSwap for secure ticket resale"
msgstr "Integre os seus eventos Pretix com o TicketSwap para revenda segura de bilhetes"

